OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- LM Studio example (local OpenAI-compatible server) ---
# 1. Load an embedding model in LM Studio (e.g. nomic-embed-text)
# 2. Start the local server (Developer tab → Start Server)
# 3. Use the values below:
# OPENAI_API_KEY=lm-studio
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# HR_EMBED_MODEL=nomic-embed-text
# HR_EMBED_DIMENSIONS=768
# HR_CHAT_MODEL=<your-loaded-chat-model-id>

DATABASE_URL=postgres://hrpolicy:hrpolicy@localhost:5432/hrpolicy?sslmode=disable
POSTGRES_USER=hrpolicy
POSTGRES_PASSWORD=hrpolicy
POSTGRES_DB=hrpolicy
POSTGRES_PORT=5432
PGVECTOR_COLLECTION=hr_policies
HR_EMBED_MODEL=text-embedding-3-small
HR_EMBED_DIMENSIONS=1536
HR_CHAT_MODEL=gpt-4o-mini
HR_INDEX_FORCE=0
LOG_LEVEL=info
LOG_FORMAT=console
HR_INGEST_VERBOSE=0
HR_CHUNK_MIN_TOKENS=500
HR_CHUNK_MAX_TOKENS=800
HR_CHUNK_OVERLAP_TOKENS=75
HR_HTTP_PORT=8080
HR_RETRIEVAL_TOP_K=5
HR_RETRIEVAL_MIN_SCORE=0.7
