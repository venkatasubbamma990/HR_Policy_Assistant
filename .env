# --- LM Studio (local OpenAI-compatible server) ---
# 1. Load models in LM Studio and start the server (Developer → Start Server)
# 2. Use these values for the models loaded in LM Studio:
#
# Chat:      google/gemma-3-12b
# Embedding: text-embedding-nomic-embed-text-v1.5
#
OPENAI_API_KEY=lm-studio
# Windows/PowerShell: use 127.0.0.1 (LM Studio on the same machine)
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# WSL: localhost does NOT reach LM Studio on Windows. One-time fix (PowerShell as Admin):
#   make setup-wsl-llm
# The app auto-rewrites this URL to http://<wsl-gateway>:12345/v1 when running in WSL.
# Or enable mirrored networking in %USERPROFILE%\.wslconfig ([wsl2] networkingMode=mirrored).
# Verify with: make check-llm
HR_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
HR_EMBED_DIMENSIONS=768
HR_CHAT_MODEL=google/gemma-3-12b

DATABASE_URL=postgres://hrpolicy:hrpolicy@localhost:5432/hrpolicy?sslmode=disable
POSTGRES_USER=hrpolicy
POSTGRES_PASSWORD=hrpolicy
POSTGRES_DB=hrpolicy
POSTGRES_PORT=5432
PGVECTOR_COLLECTION=hr_policies
HR_INDEX_FORCE=0
LOG_LEVEL=info
LOG_FORMAT=console
HR_INGEST_VERBOSE=0
HR_CHUNK_MIN_TOKENS=500
HR_CHUNK_MAX_TOKENS=800
HR_CHUNK_OVERLAP_TOKENS=75
HR_HTTP_PORT=8081
HR_RETRIEVAL_TOP_K=5
HR_RETRIEVAL_MIN_SCORE=0.7
